{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "light": {
      "primary": "#F0A23B",
      "on-primary": "#1F1404",
      "primary-ink": "#9A5A0A",
      "secondary": "#16626A",
      "on-secondary": "#FFFFFF",
      "surface": "#F6F8F7",
      "surface-container-low": "#EDF2F1",
      "surface-container-high": "#E2EAE9",
      "on-surface": "#132220",
      "on-surface-variant": "#4A5C59",
      "outline-variant": "#C9D4D2",
      "night": "#08121A",
      "night-2": "#0F2633",
      "on-night": "#EAF2F1",
      "on-night-variant": "#9FB4B6"
    },
    "dark": {
      "primary": "#F4AE4E",
      "on-primary": "#1F1404",
      "primary-ink": "#F6BA67",
      "secondary": "#6CC3C9",
      "on-secondary": "#06292C",
      "surface": "#0C1618",
      "surface-container-low": "#132124",
      "surface-container-high": "#1B2C30",
      "on-surface": "#E5EEEC",
      "on-surface-variant": "#A3B5B2",
      "outline-variant": "#2C3F42",
      "night": "#060E14",
      "night-2": "#0D2230",
      "on-night": "#EAF2F1",
      "on-night-variant": "#9FB4B6"
    },
    "welfare": {
      "health": "#D55E00",
      "material": "#E69F00",
      "freedom": "#0072B2",
      "sustain": "#009E73"
    }
  },
  "font": {
    "display": "'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif",
    "body": "'Atkinson Hyperlegible Next', 'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'Atkinson Hyperlegible Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
  },
  "type-scale-px": { "display": [48, 84], "headline": [30, 44], "title": [20, 24], "body": 17, "label": 13 },
  "space-px": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
  "radius-px": { "s": 8, "m": 16, "l": 28, "full": 999 },
  "motion": {
    "duration-ms": { "short": 150, "medium": 250, "long": 400 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "emphasized-decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)" }
  },
  "target-min-px": 48
}
