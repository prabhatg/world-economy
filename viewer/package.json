    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs && node scripts/volunteer-smoke.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@loaders.gl/core": "4.5.4",
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@noble/hashes": "2.4.0",
    "h3-js": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "playwright": "1.57.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
