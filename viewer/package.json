{
  "name": "manyworlds-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "ManyWorlds viewer: plays back ensembles of simulated worlds (ADR-0063)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/engine.mjs",
    "typecheck": "tsc --noEmit",
